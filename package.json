{
  "name": "dsh-easyrewrite",
  "version": "1.2.4",
  "description": "Bubble edit & recall for DSH Web — inline edit, undo/recall with version pager. 气泡内联编辑与撤回插件。DSH Web のバブル編集・撤回プラグイン。修复了一些已知的可能影响用户体验的问题。Includes fixes for known UX-affecting issues. 既知のユーザー体験に影響する問題を修正済み。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "sessions",
        "workspaces"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "README.ja.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "client-plugin",
    "ui",
    "plugin",
    "edit",
    "rewrite",
    "bubble-edit",
    "recall",
    "undo",
    "rollback",
    "version-pager",
    "撤回",
    "气泡编辑",
    "重编辑",
    "取り消し",
    "バブル編集",
    "編集",
    "i18n",
    "internationalization",
    "multilingual",
    "localization",
    "zh",
    "en",
    "ja"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "prepack": "node build.mjs"
  }
}
